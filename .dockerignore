# Allowlist: nothing enters the build context unless it is named here. A new
# file at the repository root (a database, a release ZIP, a .env) is therefore
# left out by default instead of being baked into the image by `COPY . .`.
*

# What the panel needs at runtime: the package (code, templates, static files),
# its entry point and its dependency list.
!app/
!main.py
!requirements.txt
!LICENSE
!README.md

# Never useful inside app/.
**/__pycache__
**/*.pyc
**/*.pyo
